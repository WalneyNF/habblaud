{
  "name": "habblaud-ai-community-vscode",
  "displayName": "Habblaud AI Community",
  "description": "Analise seleções de código com agentes Habblaud locais, sem editar arquivos automaticamente.",
  "version": "0.2.0",
  "publisher": "walneynf",
  "engines": {
    "vscode": "^1.85.0"
  },
  "main": "./extension.js",
  "activationEvents": [
    "onCommand:habblaud.analyzeSelection",
    "onCommand:habblaud.analyzeDocument",
    "onCommand:habblaud.proposeEdit"
  ],
  "contributes": {
    "commands": [
      {
        "command": "habblaud.analyzeSelection",
        "title": "Habblaud: Analisar seleção com agente"
      },
      {
        "command": "habblaud.analyzeDocument",
        "title": "Habblaud: Analisar documento aberto com agente"
      },
      {
        "command": "habblaud.proposeEdit",
        "title": "Habblaud: Propor edição supervisionada"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "habblaud.analyzeSelection",
          "when": "editorHasSelection",
          "group": "navigation@20"
        }
      ]
    },
    "configuration": {
      "title": "Habblaud AI Community",
      "properties": {
        "habblaud.serverUrl": {
          "type": "string",
          "default": "http://127.0.0.1:4747",
          "description": "Servidor Habblaud local. Somente loopback é aceito."
        }
      }
    }
  }
}