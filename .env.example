# Copie este arquivo para .env. NUNCA publique o .env real.
# Coloque as chaves abaixo sem aspas, conforme a sintaxe de env do Node.
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=...
# GROQ_API_KEY=gsk_...
# OPENROUTER_API_KEY=...
# OPENCODE_API_KEY=...
# Para outros provedores: adicione MINHA_API_KEY=... e cadastre o nome MINHA_API_KEY no laboratório.
# HABBLAUD_PORT=4747
# HABBLAUD_OLLAMA_URL=http://127.0.0.1:11434
